# Sao chép thành .env.local khi cần ghi đè (file .env* đã gitignore)
# Bỏ trống: FE gọi đường dẫn tương đối /api/v1 và để Vite proxy sang backend :8080
VITE_API_BASE_URL=/api/v1

# OAuth 2.0 Client ID của Google (cùng giá trị với GOOGLE_CLIENT_ID ở backend).
# Đây là giá trị CÔNG KHAI, lộ ra không sao — bảo mật nằm ở chỗ backend xác minh chữ ký token.
VITE_GOOGLE_CLIENT_ID=
