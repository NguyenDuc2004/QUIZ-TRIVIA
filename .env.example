# Sao chép file này thành .env rồi chỉnh giá trị:  cp .env.example .env
# Docker Compose tự đọc file .env cùng thư mục.

# ===== PostgreSQL =====
POSTGRES_DB=quizdb
POSTGRES_USER=quiz
POSTGRES_PASSWORD=quiz123
# JDBC URL cho Spring Boot:
POSTGRES_URL=jdbc:postgresql://localhost:5432/quizdb

# ===== Neo4j =====
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123
NEO4J_URI=bolt://localhost:7687

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== Security =====
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# ===== Tài khoản quản trị đầu tiên =====
# Chỉ dùng khi hệ thống CHƯA có ADMIN nào — đã có rồi thì hai biến này bị bỏ qua.
#
# Cần có vì tự đăng ký ADMIN bị chặn (security.md §1) còn đổi vai trò thì phải là admin: trên một
# CSDL mới, hai luật đó khoá lẫn nhau và không có đường nào tạo admin đầu tiên.
#
# KHÔNG seed bằng Flyway: chuỗi bcrypt trong migration là mật khẩu quản trị bị commit vào repo, và
# migration đã commit thì không sửa được để đổi mật khẩu đi.
#
# Khai CẢ HAI hoặc bỏ trống cả hai — khai một nửa thì ứng dụng dừng khởi động kèm thông báo, thay vì
# im lặng không tạo gì.
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# ===== AI =====
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_MODEL=gemini-3.6-flash
# Provider dự phòng: Groq (groq.com) — KHÔNG phải Grok của xAI.
# Lấy key miễn phí ở https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_PROVIDER_ORDER=gemini,groq

# Hạn mức AI mỗi người mỗi ngày.
#
# 0 = KHÔNG GIỚI HẠN. Số 0 ở ĐÂY và số 0 do quản trị viên đặt riêng cho một người có nghĩa NGƯỢC
# nhau: ở đây là "chưa bật tính năng", còn đặt riêng cho một người là "cấm người đó dùng AI".
# Phân biệt bằng nguồn của con số, nên cột riêng từng người để NULL được.
#
# TRIỂN KHAI THẬT: PHẢI đặt một con số. Màn đăng ký cho tự chọn vai trò Người tạo nội dung, mà vai
# trò đó gọi được sinh đề AI — để 0 thì bất kỳ ai đăng ký cũng gọi AI không giới hạn.
# Gợi ý: 20. Quản trị viên đặt riêng số cao hơn cho tài khoản cần dùng nhiều (Khu quản trị → Người dùng).
#
# Một "lượt" là MỘT HÀNH ĐỘNG của người dùng, không phải một lời gọi API: sinh đề hỏng rồi hệ thống
# tự thử lại 3 lần vẫn tính một lượt. Nạp học liệu KHÔNG tính vào đây (một tài liệu 50 đoạn là 50
# lời gọi nhúng cho một hành động) — đường đó chặn bằng trần 10 tài liệu/người học.
AI_DEFAULT_DAILY_QUOTA=0

# Số lần thử lại tối đa cho tác vụ AI chạy nền (sinh đề, nhúng học liệu). Gemini bản miễn phí cho
# 5 lượt/phút, nên tác vụ nền cần chờ lâu và thử nhiều lần hơn request đồng bộ.
AI_MAX_ATTEMPTS_BACKGROUND=4

# ===== Tệp tải lên =====
# TRIỂN KHAI THẬT: trỏ ra một volume riêng. Mặc định `uploads` là đường dẫn TƯƠNG ĐỐI so với thư mục
# chạy — trong container hoặc khi triển khai lại, toàn bộ ảnh đại diện và ảnh bìa quiz của người dùng
# biến mất cùng lớp ghi của container, và không có gì báo cho ai biết.
UPLOAD_DIR=uploads
# Giới hạn riêng cho ẢNH, chặt hơn giới hạn multipart chung (cái chung phải rộng cho học liệu RAG).
MAX_IMAGE_SIZE_BYTES=2097152

# ===== OTP đặt lại mật khẩu =====
# Ba con số này là các lớp bảo vệ đã ghi ở security.md §1 — đổi thì đọc mục đó trước.
OTP_TTL_MINUTES=10
# Số lần nhập sai tối đa trước khi huỷ mã — chặn dò 6 chữ số
OTP_MAX_ATTEMPTS=5
# Khoảng cách tối thiểu giữa hai lần xin mã, chống spam hòm thư người khác
OTP_RESEND_COOLDOWN=60

# ==========================================================
#  Địa chỉ công khai (dùng cho mã QR phòng đấu)
# ==========================================================
# Để TRỐNG khi dev: backend tự dò IP LAN, điện thoại cùng Wi-Fi quét QR được.
# Khi DEPLOY: đặt thành đúng tên miền để ai ở đâu cũng quét được.
# FRONTEND_BASE_URL=https://quiz.example.com
FRONTEND_DEV_PORT=5173

# Mẫu origin cho CORS. Để trống khi dev (mở cho localhost + IP nội bộ).
# Khi DEPLOY: đặt thành đúng tên miền.
# CORS_ALLOWED_ORIGINS=https://quiz.example.com

# ==========================================================
#  Gửi email (OTP quên mật khẩu)
# ==========================================================
# MAIL_PASSWORD là "App Password" 16 ký tự của Google, KHÔNG phải mật khẩu Gmail.
# Cách lấy: bật Xác minh 2 bước → https://myaccount.google.com/apppasswords
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=Quiz AI

# ==========================================================
#  Đăng nhập Google (FR-3)
# ==========================================================
# OAuth 2.0 Client ID loại "Web application" từ Google Cloud Console.
# KHÔNG cần Client Secret: frontend lấy ID token, backend chỉ xác minh chữ ký.
# Frontend đọc cùng giá trị này qua VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------ Email (FR-69) — TUỲ CHỌN
# ĐỂ TRỐNG MAIL_HOST thì tính năng tắt và thông báo chỉ nằm trong ứng dụng — đó là hành vi mặc định
# và hoàn toàn bình thường. Email là BẢN SAO, không phải kênh thay thế.
#
# Với Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=<địa chỉ Gmail>,
# MAIL_PASSWORD=<mật khẩu ỨNG DỤNG, không phải mật khẩu tài khoản>.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@quizai.local
