# Sao chép file này thành .env rồi chỉnh giá trị:  cp .env.example .env
# Docker Compose tự đọc file .env cùng thư mục.

# ===== PostgreSQL =====
POSTGRES_DB=quizdb
POSTGRES_USER=quiz
POSTGRES_PASSWORD=quiz123
# JDBC URL cho Spring Boot:
POSTGRES_URL=jdbc:postgresql://localhost:5432/quizdb

# ===== Neo4j =====
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123
NEO4J_URI=bolt://localhost:7687

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== Security =====
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# ===== AI =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROK_API_KEY=
GROK_MODEL=grok-2
AI_PROVIDER_ORDER=gemini,grok
